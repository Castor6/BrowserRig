{
  "name": "browserrig",
  "version": "0.3.1",
  "description": "Open-source local browser driver for trusted agents that controls your existing signed-in Chromium browser.",
  "license": "MIT",
  "contentPolicy": {
    "class": "dual-use"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Castor6/BrowserRig.git"
  },
  "homepage": "https://github.com/Castor6/BrowserRig#readme",
  "bugs": {
    "url": "https://github.com/Castor6/BrowserRig/issues"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dsh": {
      "types": "./dist/types/dsh-plugin.d.ts",
      "import": "./dist/dsh.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "extension/dist",
    "skills/browserrig/SKILL.md",
    "README.md",
    "LICENSE",
    "DISCLOSURE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "bin": {
    "browserrig": "./dist/cli.js",
    "browserrig-mcp": "./dist/mcp.js"
  },
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "bench:recording": "tsx scripts/bench-recording.ts",
    "build:cli": "tsx scripts/build-cli.ts",
    "build": "pnpm build:cli && pnpm build:extension",
    "build:extension": "tsx scripts/build-extension.ts",
    "check:extension-release": "tsx scripts/check-extension-release.ts",
    "package:npm": "tsx scripts/package-npm.ts",
    "package:extension": "pnpm build:extension && tsx scripts/package-extension.ts",
    "release:github": "tsx scripts/finalize-github-release.ts",
    "release:manifest": "tsx scripts/release-manifest.ts",
    "changeset": "changeset",
    "ci": "pnpm typecheck && pnpm test && pnpm build && pnpm package:extension",
    "prepack": "pnpm build",
    "smoke": "tsx scripts/smoke.ts",
    "sync:extension-version": "tsx scripts/sync-extension-version.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "version-packages": "changeset version && pnpm sync:extension-version"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "acorn": "^8.18.0",
    "playwright-core": "^1.62.1",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "effect": "4.0.0-rc.111"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@effect/platform-node": "4.0.0-rc.111",
    "@effect/platform-node-shared": "4.0.0-rc.111",
    "@types/chrome": "^0.2.7",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "effect": "4.0.0-rc.111",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
