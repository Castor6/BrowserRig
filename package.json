{
  "name": "browserrig",
  "version": "0.1.0",
  "description": "Open-source local browser driver for trusted agents that controls your existing signed-in Chromium browser.",
  "license": "MIT",
  "contentPolicy": {
    "class": "dual-use"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Castor6/browserrig.git"
  },
  "homepage": "https://github.com/Castor6/browserrig#readme",
  "bugs": {
    "url": "https://github.com/Castor6/browserrig/issues"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "extension/dist",
    "skills/browserrig/SKILL.md",
    "README.md",
    "LICENSE",
    "DISCLOSURE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "browserrig": "./dist/cli.js",
    "browserrig-mcp": "./dist/mcp.js"
  },
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "bench:recording": "tsx scripts/bench-recording.ts",
    "build:cli": "tsx scripts/build-cli.ts",
    "build": "pnpm build:cli && pnpm build:extension",
    "build:extension": "tsx scripts/build-extension.ts",
    "package:npm": "tsx scripts/package-npm.ts",
    "package:extension": "pnpm build:extension && tsx scripts/package-extension.ts",
    "changeset": "changeset",
    "ci": "pnpm typecheck && pnpm test && pnpm build && pnpm package:extension",
    "prepack": "pnpm build",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.97",
    "@effect/platform-node-shared": "4.0.0-beta.97",
    "acorn": "^8.17.0",
    "playwright-core": "^1.57.0",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.97"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/chrome": "^0.1.33",
    "@types/node": "^25.0.3",
    "@types/ws": "^8.18.1",
    "effect": "4.0.0-beta.97",
    "esbuild": "^0.27.2",
    "fflate": "^0.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
